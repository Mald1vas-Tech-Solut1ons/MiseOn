# ==== AMBIENTE LOCAL (Supabase local via `supabase start`) ====
# Estes são os valores padrão do Supabase local. Confirme rodando `supabase start`
# — ele imprime "API URL" e "anon key" no terminal. Cole a anon key exata aqui.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<cole aqui a anon key que o `supabase start` imprime>

# Gemini AI
VITE_GEMINI_API_KEY=

# Efi Payee Code
VITE_MISEON_EFI_PAYEE_CODE=

# USDA FoodData Central
USDA_API_KEY=

# ── WhatsApp / Meta ────────────────────────────────────────────────────────
# App MiseOn no Meta for Developers (developers.facebook.com → app MiseOn → Básico)
META_APP_ID=<App ID do painel Meta for Developers>
META_APP_SECRET=<App Secret do painel Meta for Developers → Configurações → Básico>

# Número registrado na WABA (painel Meta → WhatsApp → Configuração da API)
WHATSAPP_PHONE_NUMBER_ID=<Phone Number ID da tabela de números>
WHATSAPP_WABA_ID=<WhatsApp Business Account ID>

# Token permanente (Meta Business Manager → Usuários do Sistema → Gerar Token)
# Permissões necessárias: whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=<token permanente do System User>

# Palavra-chave inventada por você — deve ser idêntica ao campo "Verificar token" no painel Meta
WHATSAPP_VERIFY_TOKEN=miseon_webhook_2026
